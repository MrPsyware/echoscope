# Copy to info-service/.env. Never commit your .env/token/password.
# Enable LAN integration in the knob web setup and copy its API token.
ECHOSCOPE_URL=http://192.168.2.151
ECHOSCOPE_TOKEN=REPLACE_WITH_32_CHARACTER_TOKEN

# Leave blank to use history/observing alerts without MQTT.
MQTT_HOST=192.168.2.10
MQTT_PORT=1883
MQTT_USERNAME=echoscope
MQTT_PASSWORD=REPLACE_WITH_BROKER_PASSWORD
# For a TLS broker: MQTT_TLS=1, MQTT_PORT=8883 (system-trusted certificate).
MQTT_TLS=0

ENABLE_STARGAZING=1
INFO_PORT=8086
